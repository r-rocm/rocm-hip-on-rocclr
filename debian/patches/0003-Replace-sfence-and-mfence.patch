From: Sakura286 <sakura286@outlook.com>
Date: Wed, 23 Jul 2025 14:32:32 +0800
Subject: Replace sfence and mfence

---
 clr/hipamd/src/hip_graph_internal.cpp | 8 ++++++++
 clr/rocclr/device/rocm/rocvirtual.cpp | 6 +++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/clr/hipamd/src/hip_graph_internal.cpp b/clr/hipamd/src/hip_graph_internal.cpp
index 20f60a4..a347abc 100644
--- a/clr/hipamd/src/hip_graph_internal.cpp
+++ b/clr/hipamd/src/hip_graph_internal.cpp
@@ -806,9 +806,17 @@ void GraphKernelArgManager::ReadBackOrFlush() {
       address dev_ptr =
           kernarg_graph_.back().kernarg_pool_addr_ + kernarg_graph_.back().kernarg_pool_size_;
       auto kSentinel = *reinterpret_cast<volatile unsigned char*>(dev_ptr - 1);
+#if !defined(__riscv)
       _mm_sfence();
+#else
+      asm volatile("fence w,w" ::: "memory");
+#endif
       *(dev_ptr - 1) = kSentinel;
+#if !defined(__riscv)
       _mm_mfence();
+#else
+      asm volatile("fence rw,rw" ::: "memory");
+#endif
       kSentinel = *reinterpret_cast<volatile unsigned char*>(dev_ptr - 1);
     }
   }
diff --git a/clr/rocclr/device/rocm/rocvirtual.cpp b/clr/rocclr/device/rocm/rocvirtual.cpp
index 8b363c2..1ba119e 100644
--- a/clr/rocclr/device/rocm/rocvirtual.cpp
+++ b/clr/rocclr/device/rocm/rocvirtual.cpp
@@ -3565,7 +3565,11 @@ bool VirtualGPU::submitKernelInternal(const amd::NDRangeContainer& sizes,
           asm volatile("fence w,w" ::: "memory");
 #endif
         *(argBuffer + argSize - 1) = *(parameters + argSize - 1);
-        _mm_mfence();
+#if !defined(__riscv)
+          _mm_mfence();
+#else
+          asm volatile("fence rw,rw" ::: "memory");
+#endif
         auto kSentinel = *reinterpret_cast<volatile unsigned char*>(argBuffer + argSize - 1);
       }
     }
