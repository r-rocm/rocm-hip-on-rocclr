From: Sakura286 <sakura286@outlook.com>
Date: Wed, 23 Jul 2025 14:32:32 +0800
Subject: Replace sfence and mfence

---
 clr/hipamd/src/hip_graph_internal.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/clr/hipamd/src/hip_graph_internal.cpp b/clr/hipamd/src/hip_graph_internal.cpp
index 20f60a4..d2639b3 100644
--- a/clr/hipamd/src/hip_graph_internal.cpp
+++ b/clr/hipamd/src/hip_graph_internal.cpp
@@ -806,9 +806,17 @@ void GraphKernelArgManager::ReadBackOrFlush() {
       address dev_ptr =
           kernarg_graph_.back().kernarg_pool_addr_ + kernarg_graph_.back().kernarg_pool_size_;
       auto kSentinel = *reinterpret_cast<volatile unsigned char*>(dev_ptr - 1);
+#if !defined(__riscv)
       _mm_sfence();
+#else
+      asm volatile("fence w,w" ::: "memory");
+#endif
       *(dev_ptr - 1) = kSentinel;
+#if !defined(__riscv)
       _mm_mfence();
+#else
+      asm volatile("fence w,w" ::: "memory");
+#endif
       kSentinel = *reinterpret_cast<volatile unsigned char*>(dev_ptr - 1);
     }
   }
