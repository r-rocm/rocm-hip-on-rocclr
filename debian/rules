#!/usr/bin/make -f

export DH_VERBOSE = 1

PKG_NAME=rocm-hip-on-rocclr

ROCM_VERSION=$(shell cat /opt/REVYOS_ROCM_VERSION)
export ROCM_PATH=/opt/rocm-$(ROCM_VERSION)
export HIP_PATH=$(ROCM_PATH)

MAKEOPTS="-j$$(($$(nproc) / 4))"

TOP_DIR := $(shell pwd)
BUILD_PATH := $(TOP_DIR)/build-rocm
SRC_HIP := $(TOP_DIR)/hip
SRC_HIP_OTHER := $(TOP_DIR)/hipother
SRC_CLR := $(TOP_DIR)/clr

DEB_INST_DIR := $(TOP_DIR)/debian/tmp

%:
	dh $@

REVYOS_ROCM_CMAKE_PARAMS := -S $(SRC_CLR) -B $(BUILD_PATH)
REVYOS_ROCM_CMAKE_PARAMS += -DCMAKE_INSTALL_PREFIX=$(ROCM_PATH)
REVYOS_ROCM_CMAKE_PARAMS += -DCMAKE_C_COMPILER=$(ROCM_PATH)/bin/clang
REVYOS_ROCM_CMAKE_PARAMS += -DCMAKE_CXX_COMPILER=$(ROCM_PATH)/bin/clang++
REVYOS_ROCM_CMAKE_PARAMS += -DCMAKE_BUILD_TYPE=RelWithDbgInfo
REVYOS_ROCM_CMAKE_PARAMS += -DCMAKE_VERBOSE_MAKEFILE=TRUE
REVYOS_ROCM_CMAKE_PARAMS += -DCMAKE_PREFIX_PATH="$(ROCM_PATH);$(ROCM_PATH)/share/rocm/cmake/;$(ROCM_PATH)/share/rocmcmakebuildtools/cmake"

REVYOS_ROCM_CLR_CMAKE_PARAMS := -DBUILD_SHARED_LIBS=ON
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DENABLE_LDCONFIG=OFF
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DHIP_COMPILER=clang
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DHIP_PLATFORM=amd
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DHIP_COMMON_DIR=${SRC_HIP}
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DCMAKE_HIP_ARCHITECTURES=OFF
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DHSA_PATH=$(ROCM_PATH)
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DCMAKE_SKIP_BUILD_RPATH=TRUE
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DROCM_PATH=$(ROCM_PATH)
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DHIPCC_BIN_DIR=$(ROCM_PATH)/bin
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DHIP_CATCH_TEST=1
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DCLR_BUILD_HIP=ON

# TODO: I do not know if it works.
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DCLR_BUILD_OCL=ON
REVYOS_ROCM_CLR_CMAKE_PARAMS += -DBUILD_ICD=ON

override_dh_auto_configure:
	cmake $(REVYOS_ROCM_CMAKE_PARAMS) $(REVYOS_ROCM_CLR_CMAKE_PARAMS)

# -DUSE_PROF_API=OFF
# -DHIPNV_DIR=$(SRC_HIP_OTHER)/hipnv \

override_dh_auto_build:
	cmake --build $(BUILD_PATH) -- $(MAKEOPTS)

override_dh_auto_install:
	DESTDIR=$(DEB_INST_DIR)/ cmake --build $(BUILD_PATH) -- $(MAKEOPTS) install

override_dh_install:
	sed -i "s,@ROCM_VERSION@,${ROCM_VERSION},g" debian/*.install
	dh_install
